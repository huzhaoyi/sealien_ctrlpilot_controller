[Unit]
Description=Sealien AUV OBC + controller + msgs_adapter
After=network-online.target comm_bringup.service rov_bringup.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=8

[Service]
Type=simple
User=sealien
Group=dialout
WorkingDirectory=/home/sealien/sealien_auv_ws
Environment=ROS_DOMAIN_ID=99
Environment=ROS_LOCALHOST_ONLY=0
Environment=HOME=/home/sealien
ExecStartPre=/bin/sleep 8
ExecStart=/home/sealien/ctrl_bringup.sh
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
