[Unit]
Description=Sealien AUV OBC + controller + msgs_adapter
After=network-online.target comm_bringup.service imu_lora_bringup.service
Wants=network-online.target imu_lora_bringup.service
StartLimitIntervalSec=120
StartLimitBurst=8

[Service]
Type=simple
User=sealien
Group=dialout
WorkingDirectory=/home/sealien/sealien_auv_ws
Environment=ROS_DOMAIN_ID=99
Environment=ROS_LOCALHOST_ONLY=0
Environment=HOME=/home/sealien
Environment=FASTRTPS_DEFAULT_PROFILES_FILE=/home/sealien/sealien_auv_ws/install/sealien_ctrlpilot_onboardcontrol/share/sealien_ctrlpilot_onboardcontrol/config/fastdds_udp_only.xml
ExecStartPre=/bin/sleep 8
ExecStart=/home/sealien/sealien_auv_ws/src/sealien_ctrlpilot_controller/scripts/ctrl_bringup.sh
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
