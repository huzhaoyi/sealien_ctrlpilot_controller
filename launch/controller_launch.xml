<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- args that can be set from the command line or a default will be used -->
  <arg name="angle_roll_integration_limit" default="1.0" />  <!--滚转角度积分限幅-->
  <arg name="angle_pitch_integration_limit" default="1.0" />  <!--俯仰角度积分限幅-->
  <arg name="angle_yaw_integration_limit" default="1.0" />  <!--艏向角度积分限幅-->

  <arg name="rate_roll_integration_limit" default="1.0" />  <!--0对应VKB SIM遥控器-->
  <arg name="rate_pitch_integration_limit" default="1.0" />  <!--0对应VKB SIM遥控器-->
  <arg name="rate_yaw_integration_limit" default="1.0" />  <!--0对应VKB SIM遥控器-->

  <arg name="angle_roll_output_limit" default="1.0" />  <!--滚转角度PID输出限幅-->
  <arg name="angle_pitch_output_limit" default="1.0" />  <!--俯仰角度PID输出限幅-->
  <arg name="angle_yaw_output_limit" default="1.0" />  <!--艏向角度PID输出限幅-->

  <arg name="rate_roll_output_limit" default="1.0" />  <!--滚转角速度PID输出限幅-->
  <arg name="rate_pitch_output_limit" default="1.0" />  <!--俯仰角速度PID输出限幅-->
  <arg name="rate_yaw_output_limit" default="1.0" />  <!--艏向角速度PID输出限幅-->

  <arg name="pos_x_integration_limit" default="1.0" />  <!--x轴位置积分限幅-->
  <arg name="pos_y_integration_limit" default="1.0" />  <!--y轴位置积分限幅-->
  <arg name="pos_z_integration_limit" default="1.0" />  <!--z轴位置积分限幅-->

  <arg name="vel_x_integration_limit" default="1.0" />  <!---x轴速度积分限幅-->
  <arg name="vel_y_integration_limit" default="1.0" />  <!---y轴速度积分限幅-->
  <arg name="vel_z_integration_limit" default="1.0" />  <!---z轴速度积分限幅-->

  <arg name="pos_x_output_limit" default="1.0" />  <!--x轴位置PID输出限幅-->
  <arg name="pos_y_output_limit" default="1.0" />  <!--y轴位置PID输出限幅-->
  <arg name="pos_z_output_limit" default="1.0" />  <!--z轴位置PID输出限幅-->

  <arg name="vel_x_output_limit" default="1.0" />  <!--x轴速度PID输出限幅-->
  <arg name="vel_y_output_limit" default="1.0" />  <!--y轴速度PID输出限幅-->
  <arg name="vel_z_output_limit" default="1.0" />  <!--z轴速度PID输出限幅-->
  <arg name="alt_source" default="1" />  <!--高度数据来源，0:测距声呐，1:dvl, 2:imu, -->
  <arg name="height_min" default="0" />  <!--高度最小值，由高度计决定 -->
  <arg name="height_max" default="20" />  <!--高度最大值，由高度计决定 -->
  <arg name="ctrl_accuracy" default="0.02" />  <!--控制精度，单位m -->

  <arg name="thruster_base" default="0.0" />  <!--基础油门-->
  <arg name="dt" default="0.05" />  <!--控制周期0.05S(20HZ)，非必要不修改-->
  <arg name="yaw_gain" default="1.5" />  <!--航向遥控器增益-->
  <arg name="z_gain" default="0.005" />  <!--垂向遥控器增益-->
  <arg name="yaw_limit" default="180" />  <!--定向模式时，角度限幅，正范围是正负，单位是（°）-->
  <arg name="depth_min" default="-300" />  <!--深度最小值，向下为负-->
  <arg name="depth_max" default="0" />  <!--深度最大值，向下为负-->

  <arg name="angle_yaw_pid_P" default="0.01" />  <!--航向角P-->
  <arg name="angle_yaw_pid_I" default="0" />  <!--航向角I-->
  <arg name="angle_yaw_pid_D" default="0.025" />  <!--航向角D-->

  <arg name="rate_yaw_pid_P" default="1.0" />  <!--航向角速度P-->
  <arg name="rate_yaw_pid_I" default="0" />  <!--航向角速度I-->
  <arg name="rate_yaw_pid_D" default="0.1" />  <!--航向角速度D-->

  <arg name="pos_z_pid_P" default="1.2" />  <!--z轴位置P-->
  <arg name="pos_z_pid_I" default="0.1" />  <!--z轴位置I-->
  <arg name="pos_z_pid_D" default="0.0" />  <!--z轴位置D-->

  <arg name="vel_z_pid_P" default="1.0" />  <!--z轴速度P-->
  <arg name="vel_z_pid_I" default="0" />  <!--z轴速度I-->
  <arg name="vel_z_pid_D" default="0.05" />  <!--z轴速度D-->

  <node pkg="sealien_ctrlpilot_controller" exec="controller" name="controller" namespace="" args="--ros-args --log-level info" >
    <param name="angle_roll_integration_limit" value="$(var angle_roll_integration_limit)" />
    <param name="angle_pitch_integration_limit" value="$(var angle_pitch_integration_limit)" />
    <param name="angle_yaw_integration_limit" value="$(var angle_yaw_integration_limit)" />

    <param name="rate_roll_integration_limit" value="$(var rate_roll_integration_limit)" />
    <param name="rate_pitch_integration_limit" value="$(var rate_pitch_integration_limit)" />
    <param name="rate_yaw_integration_limit" value="$(var rate_yaw_integration_limit)" />

    <param name="angle_roll_output_limit" value="$(var angle_roll_output_limit)" />
    <param name="angle_pitch_output_limit" value="$(var angle_pitch_output_limit)" />
    <param name="angle_yaw_output_limit" value="$(var angle_yaw_output_limit)" />

    <param name="rate_roll_output_limit" value="$(var rate_roll_output_limit)" />
    <param name="rate_pitch_output_limit" value="$(var rate_pitch_output_limit)" />
    <param name="rate_yaw_output_limit" value="$(var rate_yaw_output_limit)" />

    <param name="pos_x_integration_limit" value="$(var pos_x_integration_limit)" />
    <param name="pos_y_integration_limit" value="$(var pos_y_integration_limit)" />
    <param name="pos_z_integration_limit" value="$(var pos_z_integration_limit)" />

    <param name="vel_x_integration_limit" value="$(var vel_x_integration_limit)" />
    <param name="vel_y_integration_limit" value="$(var vel_y_integration_limit)" />
    <param name="vel_z_integration_limit" value="$(var vel_z_integration_limit)" />

    <param name="pos_x_output_limit" value="$(var pos_x_output_limit)" />
    <param name="pos_y_output_limit" value="$(var pos_y_output_limit)" />
    <param name="pos_z_output_limit" value="$(var pos_z_output_limit)" />

    <param name="vel_x_output_limit" value="$(var vel_x_output_limit)" />
    <param name="vel_y_output_limit" value="$(var vel_y_output_limit)" />
    <param name="vel_z_output_limit" value="$(var vel_z_output_limit)" />

    <param name="thruster_base" value="$(var thruster_base)" />
    <param name="dt" value="$(var dt)" />
    <param name="yaw_gain" value="$(var yaw_gain)" />
    <param name="z_gain" value="$(var z_gain)" />
    <param name="yaw_limit" value="$(var yaw_limit)" />
    <param name="depth_min" value="$(var depth_min)" />
    <param name="depth_max" value="$(var depth_max)" />
    <param name="ctrl_accuracy" value="$(var ctrl_accuracy)" />

    <param name="angle_yaw_pid_P" value="$(var angle_yaw_pid_P)" />
    <param name="angle_yaw_pid_I" value="$(var angle_yaw_pid_I)" />
    <param name="angle_yaw_pid_D" value="$(var angle_yaw_pid_D)" />

    <param name="rate_yaw_pid_P" value="$(var rate_yaw_pid_P)" />
    <param name="rate_yaw_pid_I" value="$(var rate_yaw_pid_I)" />
    <param name="rate_yaw_pid_D" value="$(var rate_yaw_pid_D)" />

    <param name="pos_z_pid_P" value="$(var pos_z_pid_P)" />
    <param name="pos_z_pid_I" value="$(var pos_z_pid_I)" />
    <param name="pos_z_pid_D" value="$(var pos_z_pid_D)" />

    <param name="vel_z_pid_P" value="$(var vel_z_pid_P)" />
    <param name="vel_z_pid_I" value="$(var vel_z_pid_I)" />
    <param name="vel_z_pid_D" value="$(var vel_z_pid_D)" />

    <param name="alt_source" value="$(var alt_source)" />
    <param name="height_min" value="$(var height_min)" />
    <param name="height_max" value="$(var height_max)" />

    <!-- <remap from="/input/pose" to="/turtlesim1/turtle1/pose" />
    <remap from="/output/cmd_vel" to="/turtlesim2/turtle1/cmd_vel" /> -->
  </node>
</launch>


