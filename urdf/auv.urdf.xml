    </visual>
  </link>

  <joint name="joint_imu" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_imu"/>
    <origin rpy="0 0 0" xyz="0.3 0 -0.17"/>
  </joint>

  <!--dvl-->
  <link name="sensor_dvl">
    <visual>
      <geometry>
        <box size="0.6 0.1 0.2"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="red">
        <color rgba="1 0 0 1"/> <!-- 红色，不透明 -->
