  <!-- 机械臂 -->
  <link name="sensor_roboticarm">
    <visual>
      <geometry>
        <box size="0.6 0.1 0.2"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="red">
        <color rgba="1 0 0 1"/> 
      </material>
    </visual>
  </link>

  <joint name="joint_roboticarm" type="fixed">
