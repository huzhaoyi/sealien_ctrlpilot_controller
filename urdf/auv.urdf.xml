    </visual>
  </link>

  <joint name="joint_dvl" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_dvl"/>
    <origin rpy="0 0 -1.5707963" xyz="0 0.26 -0.24"/>
  </joint>

  <!--camera1-->
  <link name="sensor_camera1">
    <visual>
      <geometry>
        <box size="0.6 0.1 0.2"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
